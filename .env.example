# Copy this file to .env and fill in your keys
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LITELLM_API_KEY=...

# Zotero Web API (get key at https://www.zotero.org/settings/keys)
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user

# Semantic Scholar API (get key at https://www.semanticscholar.org/product/api#api-key)
SEMANTIC_SCHOLAR_API_KEY=

# Scopus / Elsevier (get key at https://dev.elsevier.com)
SCOPUS_API_KEY=

# Wiley TDM (request token at https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining)
WILEY_TDM_TOKEN=

# Springer Nature (register at https://dev.springernature.com)
SPRINGER_META_API_KEY=    # for searching via Meta API
SPRINGER_OA_API_KEY=      # for downloading OA papers via Open Access API

# Anna's Archive (donate at https://annas-archive.gl/donate to get API access)
ANNAS_SECRET_KEY=
ANNAS_DOWNLOAD_PATH=/tmp
ANNAS_BASE_URL=annas-archive.gl  # hostname only (binary prepends https://); override when domain changes
